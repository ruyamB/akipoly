{
  "name": "akipoly-game-backend",
  "license": "MIT",
  "version": "1.0.0",
  "description": "Akipoly minigame WebSocket backend with Arc Testnet USDC settlement",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "migrate": "node dist/db/migrate.js",
    "migrate:dev": "tsx src/db/migrate.ts",
    "loadtest": "tsx scripts/loadtest.ts",
    "check:leaderboard": "tsx scripts/leaderboard-check.ts"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "jose": "^6.2.18",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "viem": "^2.58.2",
    "ws": "^8.23.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
