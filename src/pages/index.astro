---
import '../styles/global.css';
import '../styles/home-fx.css';
import '../styles/mobile.css';
import WaitlistForm from '../components/WaitlistForm.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Waterwave from '../components/Waterwave.astro';

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta
      name="description"
      content="Akipoly: Roll. Trade. Own the Arc. The property-trading board game, reimagined as a bold, playful arcade GameFi on Arc. Join the waitlist."
    />
    <meta name="theme-color" content="#FFF500" />
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/icons/favicon-48.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Jersey+25&family=Bricolage+Grotesque:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>Akipoly — Roll. Trade. Own the Arc.</title>
    <script is:inline>
      try {
        if (sessionStorage.getItem('akipoly:wave-nav') === '1') {
          document.documentElement.classList.add('wave-pending');
        }
      } catch {
        /* private mode */
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <a class="page__help" href="/docs" aria-label="What is Akipoly? Read the explainer">?</a>
    <a class="page__dash" href="/play" aria-label="Open the Akipoly minigame">
      <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true">
        <rect x="2" y="2" width="5" height="5" rx="1" fill="currentColor" />
        <rect x="9" y="2" width="5" height="5" rx="1" fill="currentColor" />
        <rect x="2" y="9" width="5" height="5" rx="1" fill="currentColor" />
        <rect x="9" y="9" width="5" height="5" rx="1" fill="currentColor" />
      </svg>
      play
    </a>
    <main id="main" class="page home">
      <!-- decorative sparkles -->
      <svg class="page__spark page__spark--tl twinkle twinkle--1" width="54" height="54" viewBox="0 0 72 72" aria-hidden="true">
        <polygon points="36,2 41.5,26.5 66,32 41.5,37.5 36,62 30.5,37.5 6,32 30.5,26.5" fill="#FF80B5" stroke="#171717" stroke-width="4" stroke-linejoin="round" />
      </svg>
      <svg class="page__spark page__spark--tr twinkle twinkle--2" width="44" height="44" viewBox="0 0 72 72" aria-hidden="true">
        <polygon points="36,2 41.5,26.5 66,32 41.5,37.5 36,62 30.5,37.5 6,32 30.5,26.5" fill="#9DB7FB" stroke="#171717" stroke-width="4" stroke-linejoin="round" />
      </svg>
      <svg class="page__spark page__spark--bl twinkle twinkle--3" width="40" height="40" viewBox="0 0 72 72" aria-hidden="true">
        <polygon points="36,2 41.5,26.5 66,32 41.5,37.5 36,62 30.5,37.5 6,32 30.5,26.5" fill="#B8F28B" stroke="#171717" stroke-width="4" stroke-linejoin="round" />
      </svg>
      <svg class="page__spark page__spark--br twinkle twinkle--4" width="36" height="36" viewBox="0 0 72 72" aria-hidden="true">
        <polygon points="36,2 41.5,26.5 66,32 41.5,37.5 36,62 30.5,37.5 6,32 30.5,26.5" fill="#A78BFA" stroke="#171717" stroke-width="4" stroke-linejoin="round" />
      </svg>

      <section class="home__hero">
        <div class="home__copy">
          <p class="page__tag home__headline">
            Roll. Trade. <span class="page__hl">Own the Arc.</span>
          </p>
          <p class="home__sub">
            The classic property-trading game, rebuilt as a loud, fast,
            arcade-bright board on Arc. Grab a spot on the waitlist and be first
            to the dice.
          </p>

          <div class="page__form home__card" id="waitlist">
            <WaitlistForm />
          </div>
        </div>

        <div class="home__art">
          <div class="home__sunburst" aria-hidden="true"></div>
          <svg class="home__ring" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
            <defs>
              <path id="home-ring-path" d="M100,100 m-91,0 a91,91 0 1,1 182,0 a91,91 0 1,1 -182,0" />
            </defs>
            <text font-size="13" fill="#171717" textLength="568" lengthAdjust="spacing">
              <textPath href="#home-ring-path">ROLL • TRADE • OWN • ROLL • TRADE • OWN • ROLL • TRADE • OWN •</textPath>
            </text>
          </svg>
          <h1 class="home__brand">
            <img
              class="page__logo"
              src="/icons/akipoly-wordmark@1000.png"
              width="1000"
              height="798"
              alt="Akipoly"
            />
          </h1>
        </div>
      </section>

      <ul class="home__steps" aria-label="How Akipoly plays">
        <li class="home__step home__step--roll">
          <span class="home__step-num" aria-hidden="true">1</span>
          <h2>Roll</h2>
          <p>The dice decide your move. Luck gets the first word.</p>
        </li>
        <li class="home__step home__step--trade">
          <span class="home__step-num" aria-hidden="true">2</span>
          <h2>Trade</h2>
          <p>Swap, bargain and bluff your way to the best spots.</p>
        </li>
        <li class="home__step home__step--own">
          <span class="home__step-num" aria-hidden="true">3</span>
          <h2>Own</h2>
          <p>Stack the board and walk away the boss.</p>
        </li>
      </ul>

      <p class="page__legal">
        © {year} akipoly. all rights reserved.<br />
      </p>
    </main>
    <div class="home__ticker" aria-hidden="true">
      <div class="home__ticker-track">
        {Array.from({ length: 2 }).map(() => (
          <div class="home__ticker-group">
            <span>Roll</span><i>✦</i><span>Trade</span><i>✦</i><span>Own</span><i>✦</i><span>Akipoly</span><i>✦</i><span>Built on Arc</span><i>✦</i>
            <span>Roll</span><i>✦</i><span>Trade</span><i>✦</i><span>Own</span><i>✦</i><span>Akipoly</span><i>✦</i><span>Built on Arc</span><i>✦</i>
          </div>
        ))}
      </div>
    </div>
    <Waterwave />
    <style>
      .page {
        position: relative;
        z-index: 1;
      }
    </style>
    <CookieBanner />
    <script>
      import '../scripts/home-fx';
    </script>
  </body>
</html>
