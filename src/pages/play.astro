---
import '../styles/global.css';
import '../styles/play.css';
import '../styles/mobile.css';
import Dashboard from '../components/Dashboard';
import Waterwave from '../components/Waterwave.astro';

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#FFF500" />
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/icons/favicon-48.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Jersey+25&family=Bricolage+Grotesque:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>akipoly — play the minigame</title>
    <script is:inline>
      try {
        if (sessionStorage.getItem('akipoly:wave-nav') === '1') {
          document.documentElement.classList.add('wave-pending');
        }
      } catch {
        /* private mode */
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <main id="main" class="play">
      <!-- decorative sparkles -->
      <svg class="play__spark play__spark--a twinkle twinkle--1" width="48" height="48" viewBox="0 0 72 72" aria-hidden="true">
        <polygon points="36,2 41.5,26.5 66,32 41.5,37.5 36,62 30.5,37.5 6,32 30.5,26.5" fill="#FF80B5" stroke="#171717" stroke-width="4" stroke-linejoin="round" />
      </svg>
      <svg class="play__spark play__spark--b twinkle twinkle--4" width="38" height="38" viewBox="0 0 72 72" aria-hidden="true">
        <polygon points="36,2 41.5,26.5 66,32 41.5,37.5 36,62 30.5,37.5 6,32 30.5,26.5" fill="#A78BFA" stroke="#171717" stroke-width="4" stroke-linejoin="round" />
      </svg>
      <svg class="play__spark play__spark--c twinkle twinkle--3" width="40" height="40" viewBox="0 0 72 72" aria-hidden="true">
        <polygon points="36,2 41.5,26.5 66,32 41.5,37.5 36,62 30.5,37.5 6,32 30.5,26.5" fill="#B8F28B" stroke="#171717" stroke-width="4" stroke-linejoin="round" />
      </svg>

      <header class="docs__top play__top">
        <a class="docs__chip" href="/">
          <svg width="16" height="16" viewBox="0 0 18 18" aria-hidden="true">
            <path d="M12 3 6 9l6 6" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          back to the site
        </a>
        <div class="play__top-right">
          <span class="play__net"><i aria-hidden="true"></i>arc testnet</span>
          <a class="docs__chip docs__chip--brand" href="/" aria-label="akipoly — back to the site">
            <img src="/icons/akipoly-head@96.png" width="34" height="32" alt="" />
            <span>akipoly</span>
          </a>
        </div>
      </header>

      <section class="play__hero">
        <div class="play__hero-copy">
          <p class="home__badge">
            <span class="home__dot" aria-hidden="true"></span>
            minigame
          </p>
          <h1 class="play__title">play the <span class="docs__hl">minigame.</span></h1>
          <p class="play__sub">
            a ball rolls from 0 to 16. call the next one higher or lower, and back your call with a side bet if you're feeling brave.
          </p>
        </div>
        <ol class="play__rules" aria-label="How it works">
          <li class="play__rule"><b aria-hidden="true">1</b><span>buy in and take a seat</span></li>
          <li class="play__rule"><b aria-hidden="true">2</b><span>wrong call or no call and you're out</span></li>
          <li class="play__rule"><b aria-hidden="true">3</b><span>last one standing takes the pot</span></li>
        </ol>
      </section>

      <div class="dash__panel">
        <Dashboard client:only="react" />
      </div>

      <p class="page__legal play__legal">
        © {year} akipoly. all rights reserved.<br />
        arc testnet preview — nothing here holds real value. don't bet your life.
      </p>
    </main>

    <div class="home__ticker" aria-hidden="true">
      <div class="home__ticker-track">
        {Array.from({ length: 2 }).map(() => (
          <div class="home__ticker-group">
            <span>Roll</span><i>✦</i><span>Trade</span><i>✦</i><span>Own</span><i>✦</i><span>Akipoly</span><i>✦</i><span>Built on Arc</span><i>✦</i>
            <span>Roll</span><i>✦</i><span>Trade</span><i>✦</i><span>Own</span><i>✦</i><span>Akipoly</span><i>✦</i><span>Built on Arc</span><i>✦</i>
          </div>
        ))}
      </div>
    </div>
    <Waterwave />
  </body>
</html>
